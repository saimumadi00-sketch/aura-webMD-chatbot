# Public Firebase browser configuration (VITE_ values appear in the client bundle).
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
VITE_FB_MEASUREMENT_ID=
# Private server-only credentials. Put real values in ignored .env, never in this template.
OPENAI_PROJECT_ID=
OPENAI_API_KEY=sk-REPLACE_ME
# Optional URL of the separately hosted PHP doctor directory. Leave blank to disable links.
# Local example: http://127.0.0.1:8080/index.php
VITE_DOCTORS_PORTAL_URL=
# Production origin must be an exact HTTPS origin, without a trailing slash.
APP_ORIGIN=
# AI stays paused until BOTH fields below are configured. Budget resets at midnight UTC.
AI_DAILY_BUDGET_USD=
# Generate a private random secret of at least 32 characters; keep stable across restarts.
AI_QUOTA_SECRET=
AI_USAGE_FILE=private/ai-usage.json
# Enable only behind the documented loopback proxy that overwrites X-Real-IP.
AI_TRUST_LOOPBACK_PROXY=false
# Public launch details; used for metadata and information pages. Never include secrets.
VITE_PUBLIC_SITE_URL=
VITE_OPERATOR_NAME=
VITE_SUPPORT_EMAIL=
VITE_PRIVACY_EMAIL=
